# Temporary / Scratch / Transient files (Zero-Entropy)
scratch/
tmp/
temp/
*.tmp
*.temp
temp_*
scratch_*
*.bak
*.orig
*.swp
*~

# Archives (read-only history)
_archive/
AEGIS/_archive/
ARGUS/_archive/
deepseek-harness-master/

# Test-artifact empty dirs — recreated by legacy test paths
astra_bot/
kronos_bot/

# Accidental bundle guard
